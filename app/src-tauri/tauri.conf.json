{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hull-terminal",
  "identifier": "io.github.coxless.hull-terminal",
  "build": {
    "beforeDevCommand": "npm run dev:prepare",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hull-terminal",
        "width": 980,
        "height": 640,
        "minWidth": 320,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
