{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hull-terminal",
  "identifier": "io.github.coxless.hull-terminal",
  "build": {
    "beforeDevCommand": "npm run dev:prepare",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hull-terminal",
        "width": 980,
        "height": 640,
        "minWidth": 320,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi"
    ],
    "publisher": "Coxless",
    "homepage": "https://github.com/Coxless/hull",
    "category": "DeveloperTool",
    "shortDescription": "コマンドと出力をブロックとして扱うチャット履歴型のターミナル",
    "longDescription": "ウィンドウを閉じても bash が残り、開き直すと同じ bash につながるターミナル。\nPTY を持つデーモン (hull-terminal-daemon) を同梱する。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
